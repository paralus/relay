# Relay Server Environment Variables

# Core Configuration
POD_NAME=relay-pod1
POD_NAMESPACE=paralus-system
RELAY_PEERING_TOKEN=your-peering-token
PARALUS_RELAY_PEERSERVICE=https://peering.sentry.paralus.local:10001

# Timeout and Keep-alive Configuration
# Note: AWS NLB has hardcoded 350-second (5m50s) idle timeout in TCP mode
RELAY_DEFAULT_TIMEOUT=5m
RELAY_KEEPALIVE_IDLE_TIME=30s
RELAY_KEEPALIVE_COUNT=5
RELAY_KEEPALIVE_INTERVAL=10s

# Heartbeat Configuration (prevents AWS NLB connection resets)
# Must be less than 350 seconds (5m50s) - AWS NLB hardcoded timeout
RELAY_HEARTBEAT_INTERVAL=4m

# Server Configuration
RELAY_USER_HOST_PORT=:443
RELAY_CONNECTOR_HOST_PORT=:8443
RELAY_NETWORK_ID=paralus-core-64a66h0asw

# Audit and Metrics
AUDIT_PATH=/tmp
METRIC_LISTEN=:8003

# Logging
LOG_LEVEL=3